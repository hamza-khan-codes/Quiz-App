{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
      }
    },
    "user": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "course": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
    },
    "Quiz": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
    },
    "Questions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
    },
    " Questions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
    },
    "quizResults": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).child('role').val() == 'admin')",
        "$attemptId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).child('role').val() == 'admin')",
          ".validate": "newData.hasChildren(['userId', 'score', 'totalQuestions', 'percentage', 'submittedAt']) && newData.child('userId').val() == $uid && newData.child('score').isNumber() && newData.child('totalQuestions').isNumber() && newData.child('percentage').isNumber()"
        }
      }
    }
  }
}
